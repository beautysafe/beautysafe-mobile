{
  "expo": {
    "scheme": "beautysafe",
    "name": "BeautySafe",
    "slug": "beautysafe",
    "version": "2.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCE9DF"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lemsainnovation.beautysafe",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "BeautySafe utilise la caméra pour scanner les produits et prendre des photos.",
        "NSPhotoLibraryUsageDescription": "BeautySafe accède à vos photos afin de vous permettre d’envoyer les images d’un produit."
      }
    },

    "android": {
      "versionCode": 9,

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCE9DF"
      },

      "edgeToEdgeEnabled": true,

      "permissions": [
        "android.permission.CAMERA"
      ],

      "package": "com.lemsainnovation.beautysafe"
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",

      [
        "expo-camera",
        {
          "cameraPermission": "BeautySafe utilise la caméra pour scanner les produits et prendre des photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "BeautySafe accède à vos photos afin de vous permettre d’envoyer les images d’un produit.",
          "cameraPermission": "BeautySafe utilise la caméra pour scanner les produits et prendre des photos.",
          "microphonePermission": false
        }
      ],

      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5384648184645614~8973023338",
          "iosAppId": "ca-app-pub-5384648184645614~9502977111"
        }
      ],

      "expo-asset",
      "expo-secure-store"
    ],

    "extra": {
      "router": {},

      "eas": {
        "projectId": "2f4a6b5a-f6db-447a-afc9-222ffc9bdfae"
      }
    }
  }
}
