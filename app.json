{
  "expo": {
    "scheme": "beautysafe",
    "name": "BeautySafe",
    "slug": "beautysafe",
    "version": "2.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCE9DF"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "versionCode": 9,

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCE9DF"
      },

      "edgeToEdgeEnabled": true,

      "permissions": [
        "android.permission.CAMERA"
      ],

      "package": "com.lemsainnovation.beautysafe"
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",

      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5384648184645614~8973023338"
        }
      ],

      "expo-asset",
      "expo-secure-store"
    ],

    "extra": {
      "router": {},

      "eas": {
        "projectId": "2f4a6b5a-f6db-447a-afc9-222ffc9bdfae"
      }
    }
  }
}